{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "compatibility-matrix.schema.json", "type": "object", "required": ["compatibility"], "additionalProperties": false,
  "properties": { "compatibility": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false,
    "required": ["class", "first", "second", "directional", "joint", "tolerance", "action", "dofBefore", "dofAfter", "compliance", "backlash", "damping", "friction", "safeLoad", "warningLoad", "breakForce", "breakTorque", "detachUnderLoad", "failureState"],
    "properties": {
      "class": { "enum": ["TENON_LOCK", "AXLE_BEARING", "KEYED_COAXIAL", "ROPE_ATTACH"] },
      "first": { "type": "string" }, "second": { "type": "string" }, "directional": { "type": "boolean" }, "joint": { "enum": ["fixed", "revolute", "rope", "thread", "contact"] },
      "tolerance": { "type": "object", "required": ["distance", "angleDegrees"], "additionalProperties": false, "properties": { "distance": { "type": "number", "exclusiveMinimum": 0 }, "angleDegrees": { "type": "number", "exclusiveMinimum": 0, "maximum": 180 } } },
      "action": { "type": "object", "required": ["workers", "duration", "supportRequired"], "additionalProperties": false, "properties": { "workers": { "type": "integer", "minimum": 1, "maximum": 2 }, "duration": { "type": "number", "minimum": 0 }, "supportRequired": { "type": "boolean" } } },
      "dofBefore": { "type": "array", "items": { "type": "string" } }, "dofAfter": { "type": "array", "items": { "type": "string" } },
      "compliance": { "type": "number", "minimum": 0 }, "backlash": { "type": "number", "minimum": 0 }, "damping": { "type": "number", "minimum": 0 }, "friction": { "type": "number", "minimum": 0 },
      "safeLoad": { "type": "number", "exclusiveMinimum": 0 }, "warningLoad": { "type": "number", "minimum": 0 }, "breakForce": { "type": "number", "exclusiveMinimum": 0 }, "breakTorque": { "type": "number", "minimum": 0 }, "detachUnderLoad": { "type": "boolean" }, "failureState": { "enum": ["broken", "bent", "pulled_out", "slipped", "detached"] }
    }
  } } }
}
